# Base de datos
DB_HOST=localhost
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=cursos_platform

# App
PORT=3000
NODE_ENV=development
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=7d

# EnvíaloSimple Transaccional (SMTP)
# Host/puerto según panel. Puerto 587 = STARTTLS (secure=false, requireTLS=true, TLSv1.3).
SMTP_HOST=smtp.envialosimple.email
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp
SMTP_PASS=tu-password-smtp
# Remitente verificado en EnvíaloSimple (independiente del usuario SMTP)
MAIL_FROM=Capa Continua <noreply@capacontinua.com>
# Destinatario del aviso interno al crear un lead
MAIL_NOTIFY_TO=tu-email@ejemplo.com
